# ── WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup)
WA_TOKEN=EAAG...                 # permanent System User token (temporary tokens expire in 24h)
WA_PHONE_NUMBER_ID=123456789012345
WA_APP_SECRET=abc123...          # App settings → Basic → App secret (used to verify webhooks)
WA_VERIFY_TOKEN=pick-any-long-random-string
# WA_API_VERSION=v23.0

# ── Who may use the bot (your own number, international format; commas for several)
ALLOWED_NUMBERS=+254700000000

# ── Claude Code
# CLAUDE_BIN=claude
DEFAULT_CWD=/home/you/code
# Named folders you can jump between with /project <name>
PROJECTS=web=/home/you/code/web,api=/home/you/code/api
# default | acceptEdits | auto | plan | bypassPermissions
PERMISSION_MODE=acceptEdits
# Extra tools pre-approved without a prompt (comma separated), e.g. Bash(npm test:*),Bash(git status:*)
ALLOWED_TOOLS=
# MODEL=
# RUN_TIMEOUT_MIN=30
# PROGRESS_INTERVAL_SEC=30

# ── Server
PORT=3000
# DB_PATH=./bridge.db
